# Full endpoint, including organization, stream, and /_json.
O2_INGESTION_URL=https://api.openobserve.ai/api/your-org/checkout_demo/_json

# Full Authorization header value. Keep the real value out of source control.
O2_AUTH_HEADER=Basic replace-with-your-encoded-credential

# Optional tuning.
O2_EXPORT_BATCH_SIZE=10
O2_EXPORT_INTERVAL_SECONDS=0.5
DEMO_DEFAULT_RELEASE=stable
